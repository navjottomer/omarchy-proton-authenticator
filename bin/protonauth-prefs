#!/usr/bin/python3
"""Read or write the panel's preferences (pinned and recently used accounts).

  protonauth-prefs read     print the stored prefs as one JSON line
  protonauth-prefs write    replace them with the JSON document on stdin

The file lives in $XDG_STATE_HOME/navjottomer.proton-authenticator/ (default
~/.local/state/...). That directory must be a real directory owned by this
user with mode 0700; it is created that way if missing and refused otherwise,
so a planted symlink or a shared directory cannot redirect a write. Writes go
to a fresh temp file in the same directory and are renamed over prefs.json,
and reads open prefs.json with O_NOFOLLOW, so a symlink at the file itself is
never followed either.

Output and input are bounded and validated: only {"pins": {key: true},
"used": {key: epoch-seconds}} with short string keys survives.
"""
from __future__ import annotations

import json
import os
import stat
import sys
import tempfile
from pathlib import Path

APP_ID = "navjottomer.proton-authenticator"
MAX_BYTES = 256 * 1024
MAX_KEYS = 2000
MAX_KEY_CHARS = 300
EMPTY = {"pins": {}, "used": {}}


def state_dir() -> Path:
    xdg = os.environ.get("XDG_STATE_HOME", "")
    base = Path(xdg) if xdg.startswith("/") else Path.home() / ".local/state"
    return base / APP_ID


def checked_dir(create: bool) -> Path | None:
    """The state dir if it is safe to use; None if missing and not created."""
    d = state_dir()
    if create:
        d.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            pass
    try:
        st = os.lstat(d)
    except FileNotFoundError:
        return None
    if not stat.S_ISDIR(st.st_mode):
        raise SystemExit(f"{d}: not a directory (symlink?)")
    if st.st_uid != os.getuid():
        raise SystemExit(f"{d}: not owned by this user")
    if stat.S_IMODE(st.st_mode) & 0o077:
        raise SystemExit(f"{d}: must not be accessible to other users (chmod 700)")
    return d


def clean(data: object) -> dict:
    """Keep only well-formed pins/used entries."""
    out = {"pins": {}, "used": {}}
    if not isinstance(data, dict):
        return out
    pins, used = data.get("pins"), data.get("used")
    if isinstance(pins, dict):
        for k, v in list(pins.items())[:MAX_KEYS]:
            if isinstance(k, str) and 0 < len(k) <= MAX_KEY_CHARS and v is True:
                out["pins"][k] = True
    if isinstance(used, dict):
        for k, v in list(used.items())[:MAX_KEYS]:
            if (isinstance(k, str) and 0 < len(k) <= MAX_KEY_CHARS
                    and isinstance(v, int) and not isinstance(v, bool) and 0 <= v < 2**41):
                out["used"][k] = v
    return out


def read() -> dict:
    d = checked_dir(create=False)
    if d is None:
        return dict(EMPTY)
    try:
        fd = os.open(d / "prefs.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return dict(EMPTY)
    except OSError:  # ELOOP: a symlink; anything else unreadable
        return dict(EMPTY)
    with os.fdopen(fd, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            return dict(EMPTY)
        raw = fh.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        return dict(EMPTY)
    try:
        return clean(json.loads(raw))
    except ValueError:
        return dict(EMPTY)


def write(raw: bytes) -> None:
    if len(raw) > MAX_BYTES:
        raise SystemExit("prefs too large")
    data = clean(json.loads(raw))
    d = checked_dir(create=True)
    fd, tmp = tempfile.mkstemp(prefix=".prefs.", suffix=".tmp", dir=d)  # O_EXCL, 0600
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(data, fh, separators=(",", ":"))
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        # rename() replaces the name itself; it never follows a symlink there.
        os.replace(tmp, d / "prefs.json")
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) == 2 else ""
    if cmd == "read":
        print(json.dumps(read(), separators=(",", ":")))
        return 0
    if cmd == "write":
        write(sys.stdin.buffer.read(MAX_BYTES + 1))
        return 0
    print(__doc__.strip().splitlines()[0], file=sys.stderr)
    print("usage: protonauth-prefs read|write", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
