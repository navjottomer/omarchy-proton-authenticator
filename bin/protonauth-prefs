#!/usr/bin/python3
"""Read or write the panel's preferences (pinned and recently used accounts)
and its optional password lock.

  protonauth-prefs read         print the stored prefs as one JSON line
  protonauth-prefs write        replace them with the JSON document on stdin
  protonauth-prefs lock-status  print {"set": bool, "minutes": int}
  protonauth-prefs lock-verify  check the password on stdin; prints ok or no
  protonauth-prefs lock-set     change the lock from a JSON document on stdin;
                                prints ok or an error code

The lock lives next to the prefs in lock.json (mode 0600): a random salt, an
scrypt hash of the password, and the auto-lock minutes. The password is only
ever read from stdin and is never written anywhere.

The file lives in $XDG_STATE_HOME/navjottomer.proton-authenticator/ (default
~/.local/state/...). That directory must be a real directory owned by this
user with mode 0700; it is created that way if missing and refused otherwise,
so a planted symlink or a shared directory cannot redirect a write. Writes go
to a fresh temp file in the same directory and are renamed over prefs.json,
and reads open prefs.json with O_NOFOLLOW, so a symlink at the file itself is
never followed either.

Output and input are bounded and validated: only {"pins": {key: true},
"used": {key: epoch-seconds}} with short string keys survives.
"""
from __future__ import annotations

import base64
import binascii
import hashlib
import hmac
import json
import os
import stat
import sys
import tempfile
from pathlib import Path

APP_ID = "navjottomer.proton-authenticator"
MAX_BYTES = 256 * 1024
MAX_KEYS = 2000
MAX_KEY_CHARS = 300
EMPTY = {"pins": {}, "used": {}}

LOCK_FILE = "lock.json"
LOCK_MAX_BYTES = 4096
PASSWORD_MIN_CHARS = 4
PASSWORD_MAX_CHARS = 256
DEFAULT_MINUTES = 10
MAX_MINUTES = 1440
SCRYPT = {"n": 2**15, "r": 8, "p": 1, "maxmem": 128 * 1024 * 1024, "dklen": 32}


def state_dir() -> Path:
    xdg = os.environ.get("XDG_STATE_HOME", "")
    base = Path(xdg) if xdg.startswith("/") else Path.home() / ".local/state"
    return base / APP_ID


def checked_dir(create: bool) -> Path | None:
    """The state dir if it is safe to use; None if missing and not created."""
    d = state_dir()
    if create:
        d.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            pass
    try:
        st = os.lstat(d)
    except FileNotFoundError:
        return None
    if not stat.S_ISDIR(st.st_mode):
        raise SystemExit(f"{d}: not a directory (symlink?)")
    if st.st_uid != os.getuid():
        raise SystemExit(f"{d}: not owned by this user")
    if stat.S_IMODE(st.st_mode) & 0o077:
        raise SystemExit(f"{d}: must not be accessible to other users (chmod 700)")
    return d


def clean(data: object) -> dict:
    """Keep only well-formed pins/used entries."""
    out = {"pins": {}, "used": {}}
    if not isinstance(data, dict):
        return out
    pins, used = data.get("pins"), data.get("used")
    if isinstance(pins, dict):
        for k, v in list(pins.items())[:MAX_KEYS]:
            if isinstance(k, str) and 0 < len(k) <= MAX_KEY_CHARS and v is True:
                out["pins"][k] = True
    if isinstance(used, dict):
        for k, v in list(used.items())[:MAX_KEYS]:
            if (isinstance(k, str) and 0 < len(k) <= MAX_KEY_CHARS
                    and isinstance(v, int) and not isinstance(v, bool) and 0 <= v < 2**41):
                out["used"][k] = v
    return out


def read() -> dict:
    d = checked_dir(create=False)
    if d is None:
        return dict(EMPTY)
    try:
        fd = os.open(d / "prefs.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return dict(EMPTY)
    except OSError:  # ELOOP: a symlink; anything else unreadable
        return dict(EMPTY)
    with os.fdopen(fd, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            return dict(EMPTY)
        raw = fh.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        return dict(EMPTY)
    try:
        return clean(json.loads(raw))
    except ValueError:
        return dict(EMPTY)


def atomic_write(d: Path, name: str, data: object) -> None:
    fd, tmp = tempfile.mkstemp(prefix=f".{name}.", suffix=".tmp", dir=d)  # O_EXCL, 0600
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(data, fh, separators=(",", ":"))
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        # rename() replaces the name itself; it never follows a symlink there.
        os.replace(tmp, d / name)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def write(raw: bytes) -> None:
    if len(raw) > MAX_BYTES:
        raise SystemExit("prefs too large")
    data = clean(json.loads(raw))
    atomic_write(checked_dir(create=True), "prefs.json", data)


# ---------- Lock ----------

def clamp_minutes(value: object) -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        return DEFAULT_MINUTES
    return max(0, min(value, MAX_MINUTES))


def hash_password(password: str, salt: bytes) -> bytes:
    return hashlib.scrypt(password.encode(), salt=salt, **SCRYPT)


def read_lock() -> dict:
    """{"salt": bytes|None, "hash": bytes|None, "minutes": int}; a missing or
    damaged file means no password is set."""
    empty = {"salt": None, "hash": None, "minutes": DEFAULT_MINUTES}
    d = checked_dir(create=False)
    if d is None:
        return empty
    try:
        fd = os.open(d / LOCK_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return empty
    with os.fdopen(fd, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            return empty
        raw = fh.read(LOCK_MAX_BYTES + 1)
    if len(raw) > LOCK_MAX_BYTES:
        return empty
    try:
        doc = json.loads(raw)
        minutes = clamp_minutes(doc.get("minutes", DEFAULT_MINUTES))
        salt, digest = doc.get("salt"), doc.get("hash")
        if salt is None and digest is None:
            return {**empty, "minutes": minutes}
        salt = base64.b64decode(salt, validate=True)
        digest = base64.b64decode(digest, validate=True)
    except (ValueError, TypeError, AttributeError, binascii.Error):
        return empty
    if len(salt) != 16 or len(digest) != SCRYPT["dklen"]:
        return empty
    return {"salt": salt, "hash": digest, "minutes": minutes}


def write_lock(salt: bytes | None, digest: bytes | None, minutes: int) -> None:
    b64 = lambda b: None if b is None else base64.b64encode(b).decode()
    atomic_write(checked_dir(create=True), LOCK_FILE,
                 {"v": 1, "salt": b64(salt), "hash": b64(digest), "minutes": minutes})


def check_password(lock: dict, password: object) -> bool:
    if lock["hash"] is None:
        return True
    if not isinstance(password, str) or len(password) > PASSWORD_MAX_CHARS:
        return False
    return hmac.compare_digest(hash_password(password, lock["salt"]), lock["hash"])


def lock_status() -> dict:
    lock = read_lock()
    return {"set": lock["hash"] is not None, "minutes": lock["minutes"]}


def lock_verify(raw: bytes) -> str:
    lock = read_lock()
    password = raw.decode("utf-8", "replace").rstrip("\n")
    return "ok" if lock["hash"] is not None and check_password(lock, password) else "no"


def lock_set(raw: bytes) -> str:
    """Document: {"current": str, "password": str, "minutes": int}, every key
    optional. A new or empty password (removal) needs the current one when a
    password is already set; "minutes" alone needs nothing."""
    if len(raw) > LOCK_MAX_BYTES:
        return "bad-input"
    try:
        doc = json.loads(raw)
    except ValueError:
        return "bad-input"
    if not isinstance(doc, dict):
        return "bad-input"
    lock = read_lock()
    salt, digest, minutes = lock["salt"], lock["hash"], lock["minutes"]
    if "minutes" in doc:
        if isinstance(doc["minutes"], bool) or not isinstance(doc["minutes"], int):
            return "bad-input"
        minutes = clamp_minutes(doc["minutes"])
    if "password" in doc:
        new = doc["password"]
        if not isinstance(new, str):
            return "bad-input"
        if not check_password(lock, doc.get("current", "")):
            return "bad-current"
        if new == "":
            salt = digest = None
        elif PASSWORD_MIN_CHARS <= len(new) <= PASSWORD_MAX_CHARS:
            salt = os.urandom(16)
            digest = hash_password(new, salt)
        else:
            return "bad-length"
    write_lock(salt, digest, minutes)
    return "ok"


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) == 2 else ""
    if cmd == "read":
        print(json.dumps(read(), separators=(",", ":")))
        return 0
    if cmd == "write":
        write(sys.stdin.buffer.read(MAX_BYTES + 1))
        return 0
    if cmd == "lock-status":
        print(json.dumps(lock_status(), separators=(",", ":")))
        return 0
    if cmd == "lock-verify":
        print(lock_verify(sys.stdin.buffer.read(PASSWORD_MAX_CHARS * 4 + 2)))
        return 0
    if cmd == "lock-set":
        print(lock_set(sys.stdin.buffer.read(LOCK_MAX_BYTES + 1)))
        return 0
    print(__doc__.strip().splitlines()[0], file=sys.stderr)
    print("usage: protonauth-prefs read|write|lock-status|lock-verify|lock-set", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
