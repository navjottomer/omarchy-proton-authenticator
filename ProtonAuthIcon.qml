// Proton Authenticator mark in one colour, so it follows the theme like the
// built-in bar icons. Shapes are the official logo's paths
// (from proton.me; 36x36 viewBox), filled with `color` instead of Proton's
// gradients. Same shape as assets/icon.svg.
Item {
  id: root

  property real iconSize: Style.font.icon
  property color color: Color.foreground
  property real iconOpacity: 1.0

  width: iconSize
  height: iconSize
  implicitWidth: iconSize
  implicitHeight: iconSize

  Shape {
    width: 36
    height: 36
    scale: root.iconSize / 36
    transformOrigin: Item.TopLeft
    opacity: root.iconOpacity
    antialiasing: true
    preferredRendererType: Shape.CurveRenderer

